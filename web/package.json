    "next": "16.4.3",
    "pmtiles": "4.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-map-gl": "8.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
