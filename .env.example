# Free, self-serve keys. Never commit .env.
AIRNOW_API_KEY=        # https://docs.airnowapi.org/
FIRMS_MAP_KEY=         # https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Community reports (Supabase project; run supabase/schema.sql first). Use a browser-safe publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional fallback for projects using the legacy anon public key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NWS_USER_AGENT="OutlookSD (your-contact)"
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_PMTILES_URL=/tiles/sandiego.pmtiles
# Optional override for the build-only state archive (HTTPS; may be signed).
# Vercel builds default to the public raunavm/outlook-sd "state" release; local builds keep local data.
OUTLOOK_STATE_URL=
# Set to 1 in Vercel Production once state is configured; rejects missing/stale forecast coverage.
OUTLOOK_REQUIRE_LIVE_FORECASTS=0
